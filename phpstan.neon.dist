# PHPStan configuration for rtcamp/wp-primitives.
# Docs: https://phpstan.org/config-reference

includes:
    - vendor/rtcamp/wp-phpstan/phpstan.neon.dist

parameters:
    level: 8
    phpVersion:
        min: 80200
        max: 80699
    tmpDir: tests/_output/phpstan

    paths:
        - inc
        - tests/phpstan
    excludePaths:
        - node_modules (?)
        - vendor
