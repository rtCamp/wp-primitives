{
	"name": "wp-primitives",
	"private": true,
	"author": "rtCamp",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	},
	"scripts": {
		"format": "wp-scripts format . '**/*.md'",
		"format:check": "prettier --check --ignore-path .prettierignore '**/*.{cjs,cts,js,json,jsx,mjs,mts,ts,tsx,yml,yaml,md}'",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:php": "composer run-script lint",
		"lint:php:fix": "composer run-script lint:fix",
		"lint:php:types": "composer run-script analyse",
		"wp-env": "wp-env",
		"wp-env:cli": "wp-env run cli --env-cwd=wp-content/plugins/wp-primitives",
		"pretest:php": "npm run wp-env:cli -- composer install --no-interaction",
		"test:php": "npm run wp-env:cli -- vendor/bin/phpunit -c phpunit.xml.dist"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@rtcamp/eslint-config": "2.0.0",
		"@wordpress/env": "12.2.0",
		"@wordpress/prettier-config": "5.2.0",
		"@wordpress/scripts": "37.2.0",
		"prettier": "npm:wp-prettier@3.9.6"
	},
	"overrides": {
		"@wp-playground/storage": {
			"isomorphic-git": "1.38.6"
		},
		"express": {
			"qs": "6.16.2"
		},
		"prettier": "$prettier"
	}
}
