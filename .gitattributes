# Automatically normalize line endings.
* text=auto eol=lf
*.bat text eol=crlf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary

# Don't include the dotfiles for distribution.
/.* export-ignore

# Config files and directories
/tests              export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/eslint.config.mjs  export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/composer.lock      export-ignore
/release-please-config.json    export-ignore

# Documentation should be marked for GitHub Linguist
/docs/        linguist-documentation export-ignore
/AGENTS.md    linguist-documentation export-ignore
/CLAUDE.md    linguist-documentation export-ignore
/CHANGELOG.md linguist-documentation export-ignore

# Ship on purpose: README.md and LICENSE.md, inc/, plus ai/ and bin/sync-ai-instructions.js, which consumers run from vendor/ via `npm run sync-ai`.
