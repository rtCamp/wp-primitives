{
	"name": "rtcamp/wp-primitives",
	"description": "Contracts, loaders and utilities for building WordPress plugins and themes on a shared, tested base.",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"wordpress-theme",
		"framework",
		"library",
		"rtcamp"
	],
	"type": "library",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "rtCamp",
			"email": "support@rtcamp.com",
			"homepage": "https://rtcamp.com"
		}
	],
	"homepage": "https://github.com/rtCamp/wp-primitives",
	"support": {
		"issues": "https://github.com/rtCamp/wp-primitives/issues",
		"source": "https://github.com/rtCamp/wp-primitives",
		"docs": "https://opensource.rtcamp.com/wp-primitives/"
	},
	"autoload": {
		"psr-4": {
			"rtCamp\\WPPrimitives\\": "inc/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"rtCamp\\WPPrimitives\\Tests\\": [
				"tests/phpunit/"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-main": "2.x-dev"
		},
		"phpstan/extension-installer": {
			"ignore": [
				"szepeviktor/phpstan-wordpress"
			]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"scripts-descriptions": {
		"lint": "Run PHPCS against the WordPress Coding Standards.",
		"lint:fix": "Auto-fix fixable PHPCS violations.",
		"analyse": "Run PHPStan static analysis.",
		"test": "Run the PHPUnit test suite.",
		"check": "Run lint + analyse + test in sequence. Exit code 0 if all green."
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-phpunit": "^2.1",
		"phpunit/phpunit": "^9.6",
		"rtcamp/wp-phpcs": "^1.0",
		"rtcamp/wp-phpstan": "^1.0",
		"wp-phpunit/wp-phpunit": ">=6.9",
		"yoast/phpunit-polyfills": "^4.0"
	}
}
